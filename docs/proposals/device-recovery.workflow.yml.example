name: Still device recovery
on:
  push:
    branches: [qa/still-device-recovery-20261112-1]
permissions:
  contents: write
  actions: write
concurrency:
  group: still-device-recovery-20261112-1
  cancel-in-progress: false
jobs:
  recovery:
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    env:
      EXPECTED_SOURCE: REPLACE_WITH_PREPARATION_SHA
      STILL_RECOVERY_PROOF: ${{ runner.temp }}/still-recovery-proof-${{ github.run_id }}
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ env.EXPECTED_SOURCE }}
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: '24.22.2'
      - name: Two native recovery cases
        run: python3 scripts/ci-device-recovery.py
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: still-device-recovery-${{ github.run_id }}
          path: ${{ env.STILL_RECOVERY_PROOF }}/
          if-no-files-found: error
          retention-days: 2
      - name: Retire only this control
        if: always()
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          python3 - <<'PY'
          import json, os, shutil, subprocess
          from pathlib import Path
          repo = 'alvarovillalbaa/still-markdown'
          branch = 'qa/still-device-recovery-20261112-1'
          assert os.environ['GITHUB_REPOSITORY'] == repo
          assert os.environ['GITHUB_REF'] == 'refs/heads/' + branch
          def api(route, method='GET'):
              result = subprocess.run(['gh', 'api', '--method', method, 'repos/' + repo + '/' + route], capture_output=True, timeout=20)
              print(json.dumps({'route': route, 'method': method, 'exit': result.returncode, 'stdout': result.stdout.decode(), 'stderr': result.stderr.decode()}))
              assert result.returncode == 0
              return json.loads(result.stdout) if result.stdout else None
          run = api('actions/runs/' + os.environ['GITHUB_RUN_ID'])
          assert run['head_sha'] == os.environ['GITHUB_SHA'] and run['head_branch'] == branch
          assert run['path'] == '.github/workflows/device-recovery.yml'
          ref = api('git/ref/heads/' + branch)
          assert ref['object']['sha'] == run['head_sha']
          api('actions/workflows/' + str(run['workflow_id']) + '/disable', 'PUT')
          assert api('actions/workflows/' + str(run['workflow_id']))['state'] == 'disabled_manually'
          api('git/refs/heads/' + branch, 'DELETE')
          assert api('git/matching-refs/heads/' + branch) == []
          proof = Path(os.environ['STILL_RECOVERY_PROOF']).resolve()
          assert proof.parent == Path(os.environ['RUNNER_TEMP']).resolve()
          assert proof.name == 'still-recovery-proof-' + os.environ['GITHUB_RUN_ID']
          if proof.exists():
              assert (proof / 'controller.json').is_file()
              shutil.rmtree(proof)
          assert not proof.exists()
          print('STILL_RECOVERY_CONTROL_RETIRED')
          PY
